[build-system]
requires = ["setuptools>=68", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "pw_databricks_demo"
version = "0.1.0"
description = "Minimalne demo 3 typow zadan Python w Databricks Jobs"
requires-python = ">=3.9"
dependencies = []

# Nazwa z lewej strony to Entry point dla zadania Python wheel.
[project.scripts]
run_sales = "pw_databricks_demo.job:main"

[tool.setuptools.packages.find]
where = ["src"]
